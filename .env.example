# Required: Claude answers + live web search. Get it at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Recommended: realistic streaming voice (+ auto language detection for the mic).
# Get it at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: pick a voice id from https://elevenlabs.io/app/voice-library (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Recommended: fast AI-generated images (~1 second each). Get it at https://fal.ai/dashboard/keys
FAL_KEY=

# Optional tuning
CLAUDE_MODEL=claude-opus-5-5
# "fast" = up to 2.5x faster answers at 2x price. Set to "standard" to save money.
CLAUDE_SPEED=fast
PORT=3000

# Password for using it from your phone or anywhere else (npm run online).
# Without one, only this computer can open the app.
APP_PASSWORD=
# The name you call it by ("Hey Nova")
ASSISTANT_NAME=Nova
